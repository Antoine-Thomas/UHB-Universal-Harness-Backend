# End-of-line policy, so a Windows checkout cannot break the shell installers.
# (core.autocrlf=true on a contributor's machine would otherwise commit CRLF into
#  install.sh, and `bash install.sh` would fail on every Linux box with "\r".
* text=auto eol=lf

# PowerShell is happiest with CRLF; MSBuild does not care but consistency is free.
*.ps1 text eol=crlf
*.cs  text eol=crlf
*.csproj text eol=crlf

# Never touch these.
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
